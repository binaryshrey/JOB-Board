# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtualenvs ------------------------------------------------------------
.venv/
venv/
env/

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Generated data ---------------------------------------------------------
# data/ is now output only -- hand-written seed lists live in seeds/, which IS
# tracked. That split is why this can be a single blanket rule instead of a set
# of carve-outs. The database is a rebuildable artifact: `discover` + `validate`
# recreate it in minutes, and committing a multi-MB binary that churns hourly
# would wreck the history for no benefit.
data/
*.log

# --- Secrets ----------------------------------------------------------------
# Nothing here should ever hold a token: the GitHub source borrows `gh auth
# token` at runtime and never writes it to disk. This is belt and braces.
.env
.env.*
!.env.example
*.pem
credentials.json

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
